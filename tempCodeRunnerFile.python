import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Load the dataset
df = pd.read_csv('Sample data (1).xlsx - Sheet1.csv')
df.columns = df.columns.str.strip()  # remove extra spaces from column names

# 2. Basic structure
print("Shape (rows, columns):", df.shape)
print("\nColumn names:")
print(df.columns.tolist())

print("\nData types:")
print(df.dtypes)

print("\nFirst 5 rows:")
print(df.head())

# 3. Missing values
print("\nMissing values per column:")
print(df.isnull().sum())

# 4. Duplicates
print("\nNumber of duplicate rows:", df.duplicated().sum())
df = df.drop_duplicates()

# 5. Summary statistics
print("\nSummary statistics (numeric columns):")
print(df.describe())

# 6. Handle missing values (numeric columns filled with mean)
numeric_cols = df.select_dtypes(include=[np.number]).columns
for col in numeric_cols:
    df[col] = df[col].fillna(df[col].mean())

# 7. Correlation heatmap
print("\nCorrelation matrix:")
corr_matrix = df[numeric_cols].corr()
print(corr_matrix)

plt.figure(figsize=(10, 8))
sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', fmt=".2f")
plt.title("Correlation Heatmap")
plt.tight_layout()
plt.savefig('correlation_heatmap.png')
plt.show()

# 8. Find the Sales column automatically (handles 'Sales', ' Sales', 'sales', etc.)
sales_col = None
for col in df.columns:
    if col.strip().lower() == 'sales':
        sales_col = col
        break

# 9. Distribution of Sales
if sales_col:
    plt.figure(figsize=(8, 5))
    sns.histplot(df[sales_col], kde=True)
    plt.title("Distribution of Sales")
    plt.tight_layout()
    plt.savefig('sales_distribution.png')
    plt.show()
else:
    print("\nCould not find a 'Sales' column. Available columns:", df.columns.tolist())

# 10. Total Sales by Segment
segment_col = None
for col in df.columns:
    if col.strip().lower() == 'segment':
        segment_col = col
        break

if sales_col and segment_col:
    plt.figure(figsize=(10, 5))
    sns.barplot(data=df, x=segment_col, y=sales_col, estimator=sum)
    plt.title("Total Sales by Segment")
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.savefig('sales_by_segment.png')
    plt.show()

# 11. Profit vs Discounts scatter plot
profit_col = None
discounts_col = None
for col in df.columns:
    if col.strip().lower() == 'profit':
        profit_col = col
    if col.strip().lower() == 'discounts':
        discounts_col = col

if profit_col and discounts_col:
    plt.figure(figsize=(8, 5))
    sns.scatterplot(data=df, x=discounts_col, y=profit_col)
    plt.title("Profit vs Discounts")
    plt.tight_layout()
    plt.savefig('profit_vs_discounts.png')
    plt.show()

# 12. Save the cleaned dataset
df.to_csv('cleaned_sales_data.csv', index=False)
print("\nCleaned data saved as cleaned_sales_data.csv")